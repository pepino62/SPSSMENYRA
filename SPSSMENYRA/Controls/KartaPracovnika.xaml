<jr:JisWindow
    x:Class="SPSSMENYRA.KartaPracovnika"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:jr="clr-namespace:JisResources;assembly=JisResources"
    Title="Karta pracovníka">

    <!-- VFP SPORT1 - karta pracovnika -->
    <Border Margin="10" Padding="10" CornerRadius="2" BorderBrush="#979AAA" BorderThickness="1" Background="#C1E6B6">
        <StackPanel>
            <TextBlock x:Name="txtNadpis" Margin="0,0,0,12" FontSize="16" FontWeight="Bold" Foreground="#8B0040" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="typ :" Style="{StaticResource LBL_VERT}" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="110" Margin="2" HorizontalAlignment="Left"
                          ItemsSource="{Binding Typy}" DisplayMemberPath="Nazev" SelectedValuePath="Kod"
                          SelectedValue="{Binding Pracovnik.Ft307}" Style="{DynamicResource JisComboBox}" />
                <Label Grid.Row="0" Grid.Column="2" Content="stav :" Style="{StaticResource LBL_VERT}" Margin="15,0,0,0" />
                <ComboBox Grid.Row="0" Grid.Column="3" Width="100" Margin="2" HorizontalAlignment="Left"
                          ItemsSource="{Binding Stavy}" DisplayMemberPath="Nazev" SelectedValuePath="Kod"
                          SelectedValue="{Binding Pracovnik.F0}" Style="{DynamicResource JisComboBox}" />

                <Label Grid.Row="1" Grid.Column="0" Content="jméno :" Style="{StaticResource LBL_VERT}" />
                <jr:JisTextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Width="130" HorizontalAlignment="Left" MaxLength="15"
                               Text="{Binding Pracovnik.Ft302, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GET_LEFT}"
                               LostFocus="Jmeno_LostFocus" ToolTip="jméno zobrazované v rozpisu služeb" />

                <Label Grid.Row="2" Grid.Column="0" Content="celé jméno :" Style="{StaticResource LBL_VERT}" />
                <jr:JisTextBox x:Name="txtCeleJmeno" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Width="230" HorizontalAlignment="Left" MaxLength="30"
                               Text="{Binding Pracovnik.Ft303, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GET_LEFT}" />

                <Label Grid.Row="3" Grid.Column="0" Content="dat.narození :" Style="{StaticResource LBL_VERT}" />
                <DatePicker Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="2"
                            SelectedDate="{Binding Pracovnik.Ft305}" SelectedDateChanged="Narozeni_Changed" Style="{StaticResource DTP}" />
                <Label Grid.Row="3" Grid.Column="2" Content="věk :" Style="{StaticResource LBL_VERT}" Margin="15,0,0,0" />
                <TextBlock x:Name="txtVek" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="Bold" />

                <Label Grid.Row="4" Grid.Column="0" Content="telefon :" Style="{StaticResource LBL_VERT}" />
                <jr:JisTextBox Grid.Row="4" Grid.Column="1" Width="110" HorizontalAlignment="Left"
                               Text="{Binding Pracovnik.Ft306, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GET_LEFT}"
                               jr:MaskBehavior.Mask="000 000 000" />

                <Label Grid.Row="5" Grid.Column="0" Content="úvazek :" Style="{StaticResource LBL_VERT}" />
                <jr:JisTextBox Grid.Row="5" Grid.Column="1" Width="60" HorizontalAlignment="Left" MaxLength="4"
                               Text="{Binding Pracovnik.Ft304, StringFormat=0}" Style="{StaticResource GET_RIGHT}" />
            </Grid>

            <!-- dovolena v roce -->
            <Border Margin="0,12,0,0" Padding="8" CornerRadius="3" BorderBrush="#7A8A9A" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label x:Name="lblPlan" Grid.Row="0" Grid.Column="0" Style="{StaticResource LBL_VERT}" />
                    <jr:JisTextBox Grid.Row="0" Grid.Column="1" Width="50" MaxLength="5"
                                   Text="{Binding Pracovnik.Dovp, StringFormat=0.0}" Style="{StaticResource GET_RIGHT}" />
                    <Label Grid.Row="1" Grid.Column="0" Content="vyčerpáno :" Style="{StaticResource LBL_VERT}" />
                    <TextBlock x:Name="txtDovv" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" FontWeight="Bold" />
                    <jr:JisButton x:Name="btnDovolena" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="20,0,0,0" HorizontalAlignment="Right"
                                  Content=" DOVOLENÁ " Style="{StaticResource BUTT_DARK}" Background="SteelBlue" Click="BtnDovolena_Click"
                                  ToolTip="přehled a zadání čerpání dovolené" />
                </Grid>
            </Border>

            <Label Content="poznámka :" Style="{StaticResource LBL_VERT}" Margin="0,8,0,0" />
            <jr:JisEditBox Height="70" Width="330" HorizontalAlignment="Left"
                           Text="{Binding Pracovnik.Ft309, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GET_EDITBOX}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <jr:JisButton Content=" ULOŽIT " Style="{StaticResource BUTT_DARK}" Background="#E0107F" Click="BtnUlozit_Click" Margin="0,0,10,0" />
                <jr:JisButton Content=" ZPĚT " Style="{StaticResource BUTT_DARK}" Background="SteelBlue" Click="BtnZpet_Click" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</jr:JisWindow>
