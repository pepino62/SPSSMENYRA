<jr:JisUserControl x:Class="SPSSMENYRA.Rozpis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SPSSMENYRA"
             mc:Ignorable="d"
             xmlns:jr="clr-namespace:JisResources;assembly=JisResources">
    <Grid Margin="10">
        <Grid.RowDefinitions >
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- vyber roku a mesice (VFP SPORT0_CNT004) -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" CornerRadius="2" BorderBrush="#979AAA" BorderThickness="1" Background="#94D880" HorizontalAlignment="Left" >
            <StackPanel Orientation="Horizontal" Margin="5" >
                <Label Content="Na rok :" Style="{DynamicResource LBL_CENTER}" />
                <ComboBox x:Name="cboRok"
                          MinWidth="70"
                          Margin="2,0,15,0"
                          ItemsSource="{Binding Roky}"
                          SelectedValue="{Binding Rok}"
                          SelectionChanged="CboMesic_SelectionChanged"
                          Style="{DynamicResource JisComboBox}" />

                <Label Content="měsíc :" Style="{DynamicResource LBL_CENTER}" />
                <ComboBox x:Name="cboMesic"
                          MinWidth="110"
                          Margin="2,0,15,0"
                          ItemsSource="{Binding Mesice}"
                          DisplayMemberPath="Nazev"
                          SelectedValuePath="Cislo"
                          SelectedValue="{Binding Mesic}"
                          SelectionChanged="CboMesic_SelectionChanged"
                          Style="{DynamicResource JisComboBox}" />

                <jr:JisButton Content=" OBNOVIT " Style="{StaticResource BUTT_DARK}" Background="SteelBlue" Click="BtnObnovit_Click"
                              ToolTip="znovu načte rozpis vybraného měsíce" VerticalAlignment="Center" Margin="10,0,0,0" />
                <jr:JisButton Content=" TISK " Style="{StaticResource BUTT_DARK}" Background="#8B4AA8" Click="BtnTisk_Click"
                              ToolTip="tisk rozpisu služeb vybraného měsíce se součty pracovníků (PDF z náhledu)" VerticalAlignment="Center" Margin="20,0,0,0" />
                <jr:JisButton Content=" TISK ROKU " Style="{StaticResource BUTT_DARK}" Background="#8B4AA8" Click="BtnTiskRoku_Click"
                              ToolTip="tisk rozpisu služeb všech měsíců roku (PDF z náhledu)" VerticalAlignment="Center" Margin="10,0,0,0" />

                <!-- filtr podle oznacenych pracovniku v pravem gridu -->
                <TextBlock Text="{Binding FiltrText}" Margin="15,0,5,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#B00060"
                           ToolTip="zrušit: odznačit pracovníky v pravém seznamu" />
            </StackPanel>
        </Border>

        <!-- rozpis (VFP SPORT0_GRD001) - dvojklik: vyber casu / pracovnika / hodin, prave tlacitko: radky -->
        <jr:JisDataGrid x:Name="USERDATAGRID1" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"
                        jisWgridSkey="SMENY_ROZPIS"
                        jisSourceName="rozpis"/>

        <!-- soucty pracovniku (VFP SPORT0_GRD002) -->
        <jr:JisDataGrid x:Name="USERDATAGRID2" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left"
                        jisWgridSkey="SMENY_PRACOVNICI"
                        jisSourceName="pracovnici"/>

    </Grid>
</jr:JisUserControl>
